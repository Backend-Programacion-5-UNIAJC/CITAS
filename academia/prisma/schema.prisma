generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id       Int    @id @default(autoincrement())
  title    String
  capacity Int
}

model Paciente {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  phone String
}

model Doctor {
  id             Int    @id @default(autoincrement())
  name           String
  email String @unique
  especialidadId Int
}

model Especialidad {
  id          Int    @id @default(autoincrement())
  name        String
  description String
}
